[Unit]
Description=Dash Platform latest public Core testnet sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=platform-sync
Group=platform-sync
EnvironmentFile=/etc/latest-core-testnet-sync.env
ExecStart=/bin/bash -lc 'cd "${PLATFORM_REPO_DIR:-/opt/dash-platform}" && exec ops/latest-core-testnet-sync/run-worker.sh'
TimeoutStartSec=0
StateDirectory=latest-core-testnet-sync
LogsDirectory=latest-core-testnet-sync
