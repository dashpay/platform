# Copy to `.env` and fill in. The scripts read these (loadDotEnv) or you can
# export them in the shell. `.env` is gitignored — never commit a private key.

# Target network (testnet | mainnet | local). Defaults to testnet.
NETWORK=testnet

# The QA identity that owns the contract and creates all documents (v1).
# base58 identity id.
QA_IDENTITY_ID=

# Private key for an AUTHENTICATION key on QA_IDENTITY_ID with HIGH or CRITICAL
# security level. WIF or 64-char hex. TESTNET KEY ONLY.
QA_PRIVATE_KEY=

# Optional: pin the signing key by id instead of auto-detecting it from the key above.
# QA_IDENTITY_KEY_ID=2

# Optional: override the TEST_PLAN commit stamped onto seeded testCases.
# Defaults to the git short-sha of TEST_PLAN.md.
# PLAN_COMMIT=

# Optional: import the SDK from a prebuilt bundle instead of the installed
# @dashevo/evo-sdk package (handy in-repo when the workspace package is built
# elsewhere). Absolute path to dist/evo-sdk.module.js.
# EVO_SDK_BUNDLE=/abs/path/to/packages/js-evo-sdk/dist/evo-sdk.module.js
