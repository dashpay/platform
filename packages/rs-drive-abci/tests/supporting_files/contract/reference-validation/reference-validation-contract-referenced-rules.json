{
  "$formatVersion": "1",
  "id": "31TfU1koATcamnBrNiRbturPP5kLaE8VzJcojeTxedxR",
  "ownerId": "2b994p95akyNFKtkDnDvBRUotDbkH54MHwGbhQLr5gcU",
  "version": 1,
  "documentSchemas": {
    "poll": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "option0": { "type": "string", "minLength": 1, "maxLength": 100, "position": 0 },
        "option1": { "type": "string", "minLength": 1, "maxLength": 100, "position": 1 },
        "option2": { "type": "string", "minLength": 1, "maxLength": 100, "position": 2 },
        "multiChoice": { "type": "boolean", "position": 3 },
        "endsAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "position": 4 }
      },
      "required": ["option0", "option1", "$createdAt"],
      "additionalProperties": false
    },
    "vote": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "pollId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": { "type": "deletableDocument", "documentType": "poll" },
          "position": 0
        },
        "choice": { "type": "integer", "minimum": 0, "maximum": 9, "position": 1 },
        "note": { "type": "string", "maxLength": 50, "position": 2 }
      },
      "required": ["pollId", "choice", "$createdAt", "$updatedAt"],
      "propertyConstraints": {
        "castBeforeTheEnd": {
          "lessThan": [
            "$updatedAt",
            { "ifAbsent": [{ "referenced": ["pollId", "endsAt"] }, 9007199254740991] }
          ]
        },
        "singleChoicePoll": { "equal": [{ "referenced": ["pollId", "multiChoice"] }, 0] },
        "choiceIsAnOption": {
          "lessThan": [
            "choice",
            {
              "countPresent": [
                { "referenced": ["pollId", "option0"] },
                { "referenced": ["pollId", "option1"] },
                { "referenced": ["pollId", "option2"] }
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "deadlineVote": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "pollId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "poll",
            "where": {
              "endsAt": { "greaterThan": "$updatedAt" },
              "multiChoice": { "notEqual": { "const": true } }
            }
          },
          "position": 0
        },
        "note": { "type": "string", "maxLength": 50, "position": 1 }
      },
      "required": ["pollId", "$createdAt", "$updatedAt"],
      "additionalProperties": false
    },
    "auction": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": false,
      "properties": {
        "reservePrice": { "type": "integer", "minimum": 0, "maximum": 1000000000, "position": 0 },
        "status": { "type": "string", "enum": ["open", "extended", "closed"], "maxLength": 10, "position": 1 }
      },
      "required": ["reservePrice", "status"],
      "additionalProperties": false
    },
    "bid": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "auctionId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "auction",
            "where": { "status": { "in": ["open", "extended"] } }
          },
          "position": 0
        },
        "amount": { "type": "integer", "minimum": 0, "maximum": 1000000000, "position": 1 },
        "note": { "type": "string", "maxLength": 50, "position": 2 }
      },
      "required": ["auctionId", "amount"],
      "propertyConstraints": {
        "atLeastReserve": {
          "greaterThanOrEqual": ["amount", { "referenced": ["auctionId", "reservePrice"] }]
        }
      },
      "additionalProperties": false
    },
    "raise": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "auctionId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": { "type": "permanentDocument", "documentType": "auction" },
          "position": 0
        },
        "amount": { "type": "integer", "minimum": 0, "maximum": 1000000000, "position": 1 }
      },
      "required": ["auctionId", "amount"],
      "propertyConstraints": {
        "raisesByTheReserve": {
          "greaterThanOrEqual": [
            "amount",
            {
              "add": [
                { "ifAbsent": ["$old.amount", 0] },
                { "referenced": ["auctionId", "reservePrice"] }
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "status": { "type": "string", "enum": ["pending", "delivered"], "maxLength": 10, "position": 0 }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "orderId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "order",
            "where": { "status": { "const": "delivered" } }
          },
          "position": 0
        },
        "stars": { "type": "integer", "minimum": 1, "maximum": 5, "position": 1 }
      },
      "required": ["orderId", "stars"],
      "additionalProperties": false
    },
    "rebuttal": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "orderId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "order",
            "where": { "$ownerId": { "notEqual": "$ownerId" } }
          },
          "position": 0
        }
      },
      "required": ["orderId"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": false,
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 20, "position": 0 },
        "capacity": { "type": "integer", "minimum": 0, "maximum": 100000, "position": 1 }
      },
      "indices": [{ "name": "byCode", "properties": [{ "code": "asc" }], "unique": true }],
      "required": ["code", "capacity"],
      "additionalProperties": false
    },
    "ticket": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "eventCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "event",
            "findBy": { "code": "." }
          },
          "position": 0
        },
        "seat": { "type": "integer", "minimum": 0, "maximum": 100000, "position": 1 }
      },
      "required": ["eventCode", "seat"],
      "propertyConstraints": {
        "seatExists": { "lessThan": ["seat", { "referenced": ["eventCode", "capacity"] }] }
      },
      "additionalProperties": false
    },
    "ballot": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": false,
      "properties": {
        "endsAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "position": 0 }
      },
      "required": ["endsAt", "$createdAt"],
      "additionalProperties": false
    },
    "ballotEntry": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "ballotId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "ballot",
            "where": { "endsAt": { "greaterThan": "$updatedAt" } }
          },
          "position": 0
        },
        "note": { "type": "string", "maxLength": 50, "position": 1 }
      },
      "required": ["ballotId", "$createdAt", "$updatedAt"],
      "additionalProperties": false
    },
    "ballotList": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "ballotIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "byteArray": true,
            "minItems": 32,
            "maxItems": 32,
            "contentMediaType": "application/x.dash.dpp.identifier",
            "refersTo": {
              "type": "permanentDocument",
              "documentType": "ballot",
              "where": { "endsAt": { "greaterThan": { "const": 100 } } }
            }
          },
          "position": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ballotOrAuction": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "targetId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "anyOf": [
              {
                "type": "permanentDocument",
                "documentType": "ballot",
                "where": { "endsAt": { "greaterThan": { "const": 100 } } }
              },
              {
                "type": "permanentDocument",
                "documentType": "auction",
                "where": { "status": { "const": "open" } }
              }
            ]
          },
          "position": 0
        }
      },
      "required": ["targetId"],
      "additionalProperties": false
    },
    "pass": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "eventCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "event",
            "findBy": { "code": "." },
            "where": { "capacity": { "greaterThan": { "const": 1 } } }
          },
          "position": 0
        }
      },
      "required": ["eventCode"],
      "additionalProperties": false
    },
    "nestedVote": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "pollId": {
              "type": "array",
              "byteArray": true,
              "minItems": 32,
              "maxItems": 32,
              "contentMediaType": "application/x.dash.dpp.identifier",
              "refersTo": { "type": "deletableDocument", "documentType": "poll" },
              "position": 0
            }
          },
          "required": ["pollId"],
          "additionalProperties": false,
          "position": 0
        }
      },
      "required": ["meta"],
      "propertyConstraints": {
        "singleChoicePoll": { "equal": [{ "referenced": ["meta.pollId", "multiChoice"] }, 0] }
      },
      "additionalProperties": false
    }
  }
}
